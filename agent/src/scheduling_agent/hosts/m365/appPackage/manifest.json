{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.22/MicrosoftTeams.schema.json",
  "manifestVersion": "1.22",
  "version": "0.1.0",
  "id": "${{TEAMS_APP_ID}}",
  "developer": {
    "name": "Contoso Recruiting Operations",
    "websiteUrl": "https://www.contoso.example",
    "privacyUrl": "https://www.contoso.example/privacy",
    "termsOfUseUrl": "https://www.contoso.example/terms"
  },
  "icons": { "color": "color.png", "outline": "outline.png" },
  "name": { "short": "Interview Scheduler", "full": "Interview Scheduling Agent" },
  "description": {
    "short": "Find, book, and repair interview schedules.",
    "full": "Turns candidate availability and the interview plan into valid schedules across time zones, explains near fits, and books Outlook invitations only after you confirm. It schedules; it never assesses candidates."
  },
  "accentColor": "#2F5DA8",
  "bots": [
    {
      "botId": "${{BOT_ID}}",
      "scopes": ["personal", "copilot"],
      "supportsFiles": false,
      "isNotificationOnly": false,
      "commandLists": [
        {
          "scopes": ["personal", "copilot"],
          "commands": [
            { "title": "new case", "description": "Start a new scheduling case" },
            { "title": "show case", "description": "Show what I know about the current case" }
          ]
        }
      ]
    }
  ],
  "copilotAgents": {
    "customEngineAgents": [
      {
        "id": "${{BOT_ID}}",
        "type": "bot",
        "disclaimer": { "text": "Proposals are not reservations. Nothing is booked or sent until you confirm, unless you have explicitly enabled autonomous scheduling." }
      }
    ]
  },
  "permissions": ["identity"],
  "validDomains": ["${{BOT_DOMAIN}}"],
  "webApplicationInfo": { "id": "${{BOT_ID}}", "resource": "api://botid-${{BOT_ID}}" }
}
