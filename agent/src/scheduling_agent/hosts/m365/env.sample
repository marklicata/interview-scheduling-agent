# Microsoft 365 host configuration. Copy to .env (git-ignored) or set in Azure App Service settings.

# --- Agents SDK service connection (Azure Bot / Entra app registration) ---
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTID=<bot app (client) id>
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTSECRET=<secret, or use a managed identity / certificate>
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__TENANTID=<tenant id>

# --- Delegated Microsoft Graph access for the signed-in recruiter (Azure Bot OAuth connection named below) ---
# Scopes: Calendars.ReadWrite, Calendars.ReadWrite.Shared (shared organizer mailbox), Mail.Send,
#         User.ReadBasic.All, MailboxSettings.Read
AGENTAPPLICATION__USERAUTHORIZATION__HANDLERS__GRAPH__SETTINGS__AZUREBOTOAUTHCONNECTIONNAME=graph

# --- Scheduling ---
SCHEDULING_PROVIDER=graph                       # graph | memory (memory = offline try-out, no real calendars)
SCHEDULING_ORGANIZER=                           # shared recruiting mailbox UPN; empty = the signed-in user
SCHEDULING_CASE_DIR=.cases                      # local JSON case store (development only)
SCHEDULING_DEFAULT_WORK_START=09:00             # fallback working hours when none are known
SCHEDULING_DEFAULT_WORK_END=17:00
SCHEDULING_DEFAULT_WORK_DAYS=Mon,Tue,Wed,Thu,Fri,Sat,Sun
SCHEDULING_DEFAULT_SEARCH_DAYS=30

# --- Model (Claude). Product data is used for inference only; never for training (INV-09). ---
# Provider is chosen by MODEL_PROVIDER at the top of core/llm.py (use "foundry" for Azure deployments).
ANTHROPIC_FOUNDRY_RESOURCE=<foundry resource name>
# ANTHROPIC_FOUNDRY_API_KEY=<key>               # omit to use Entra ID (managed identity)
SCHEDULING_AGENT_MODEL=claude-opus-5-5
SCHEDULING_AGENT_EFFORT=high
