# Microsoft 365 host configuration. Copy to .env (git-ignored) or set in Azure App Service / Container App settings.

# --- Agents SDK service connection (Azure Bot / Entra app registration) ---
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTID=<bot app (client) id>
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTSECRET=<secret, or use a managed identity / certificate>
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__TENANTID=<tenant id>

# --- Delegated Microsoft Graph access for the signed-in recruiter (Azure Bot OAuth connection named below) ---
# Scopes: Calendars.ReadWrite, Calendars.ReadWrite.Shared (shared organizer mailbox), Mail.Send,
#         User.ReadBasic.All, MailboxSettings.Read
AGENTAPPLICATION__USERAUTHORIZATION__HANDLERS__GRAPH__SETTINGS__AZUREBOTOAUTHCONNECTIONNAME=graph

# --- Scheduling ---
SCHEDULING_PROVIDER=graph                       # graph | memory (memory = offline try-out, no real calendars)
SCHEDULING_ORGANIZER=                           # shared recruiting mailbox UPN; empty = the signed-in user
SCHEDULING_CASE_DIR=.cases                      # local JSON case store (development only)
SCHEDULING_DEFAULT_WORK_START=09:00             # fallback working hours when none are known
SCHEDULING_DEFAULT_WORK_END=17:00
SCHEDULING_DEFAULT_WORK_DAYS=Mon,Tue,Wed,Thu,Fri,Sat,Sun
SCHEDULING_DEFAULT_SEARCH_DAYS=30

# --- Model. Product data is used for inference only; never for training (INV-09). ---
# Choose a provider with SCHEDULING_MODEL_PROVIDER:
#
#   copilot   – GitHub Copilot CLI (local development; no credentials needed; default when unset)
#
#   anthropic – Direct Anthropic API (prototype deployments)
#               Requires: ANTHROPIC_API_KEY
#
#   foundry   – Azure AI Foundry, any deployed OpenAI-format model (production on Azure)
#               Requires: AZURE_FOUNDRY_RESOURCE or AZURE_FOUNDRY_ENDPOINT
#               Auth: managed identity by default (recommended); set AZURE_FOUNDRY_API_KEY to use a key instead
#               Model: set SCHEDULING_AGENT_MODEL to the deployment name (e.g. gpt-6.1-sol)
#
SCHEDULING_MODEL_PROVIDER=foundry

# Required for SCHEDULING_MODEL_PROVIDER=anthropic
# ANTHROPIC_API_KEY=<api key>

# Required for SCHEDULING_MODEL_PROVIDER=foundry
AZURE_FOUNDRY_RESOURCE=<resource name, e.g. fountry-scheduling-agent>
# AZURE_FOUNDRY_ENDPOINT=<full endpoint URL; alternative to AZURE_FOUNDRY_RESOURCE>
# AZURE_FOUNDRY_API_KEY=<api key; omit to use managed identity (recommended)>
# AZURE_FOUNDRY_API_VERSION=2025-04-01-preview

SCHEDULING_AGENT_MODEL=gpt-6.1-sol             # deployment name for foundry; Claude id for anthropic/copilot
SCHEDULING_AGENT_EFFORT=high
